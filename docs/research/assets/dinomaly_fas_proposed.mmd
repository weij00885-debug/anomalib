flowchart TD
    X["RGB 人脸"] --> E["冻结 DINOv2"]
    E --> S["1 SLR：输入侧保值层选择"]
    S --> B["原瓶颈 + 原解码器"]
    E --> T["固定分组 mean 目标"]
    B --> Y["固定分组 mean 预测"]
    T --> R["两组原生 patch cosine 残差"]
    Y --> R
    R --> C["2 RCNC：正常区域统计校准"]
    C --> BASE["基础图像分数与候选区域"]
    BASE --> MASK["3 CMV：候选区域图像遮挡"]
    X --> MASK
    MASK --> SECOND["重跑同一冻结编码器 + 共享重建网络"]
    SECOND --> V["与 clean 固定目标比较，仅评分遮挡区域"]
    T --> V
    V --> NC["匹配区域/面积的真人复核代价校准"]
    BASE --> F["校准后的分数组合"]
    NC --> F
    F --> O["检测结果 + 可核查证据"]
    O -.-> LANG["可选：模板 / 语言报告"]
